{
  "info": {
    "name": "B2C Chatbot API",
    "description": "API collection cho chatbot system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "TOKEN",
      "value": "your_jwt_token_here",
      "type": "string"
    },
    {
      "key": "ADMIN_TOKEN",
      "value": "your_admin_jwt_token_here",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "USER ENDPOINTS",
      "item": [
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Tôi muốn mua iPhone 15 Pro\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/chatbot/message",
              "host": ["{{BASE_URL}}"],
              "path": ["chatbot", "message"]
            },
            "description": "Gửi tin nhắn cho chatbot, nhận lại response và danh sách sản phẩm"
          },
          "response": []
        },
        {
          "name": "Get Chat History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/chatbot/history?limit=20",
              "host": ["{{BASE_URL}}"],
              "path": ["chatbot", "history"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Lấy lịch sử cuộc trò chuyện của user"
          },
          "response": []
        },
        {
          "name": "Search Products",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"keywords\": [\"laptop\", \"gaming\"]\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/chatbot/search-products",
              "host": ["{{BASE_URL}}"],
              "path": ["chatbot", "search-products"]
            },
            "description": "Tìm kiếm sản phẩm không cần đăng nhập"
          },
          "response": []
        }
      ]
    },
    {
      "name": "ADMIN ENDPOINTS",
      "item": [
        {
          "name": "Get Config",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ADMIN_TOKEN}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/chatbot/admin/config",
              "host": ["{{BASE_URL}}"],
              "path": ["chatbot", "admin", "config"]
            },
            "description": "Lấy cấu hình hiện tại của chatbot (yêu cầu admin)"
          },
          "response": []
        },
        {
          "name": "Update Stop Words",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ADMIN_TOKEN}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stopWords\": [\n    \"là\",\n    \"có\",\n    \"để\",\n    \"và\",\n    \"một\",\n    \"cái\",\n    \"thì\",\n    \"này\",\n    \"kia\",\n    \"được\",\n    \"mà\",\n    \"hay\",\n    \"khi\",\n    \"cần\",\n    \"phải\",\n    \"bạn\",\n    \"tôi\",\n    \"tìm\",\n    \"muốn\"\n  ]\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/chatbot/admin/config/stop-words",
              "host": ["{{BASE_URL}}"],
              "path": ["chatbot", "admin", "config", "stop-words"]
            },
            "description": "Cập nhật danh sách stop words (yêu cầu admin)"
          },
          "response": []
        },
        {
          "name": "Get Analytics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ADMIN_TOKEN}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/chatbot/admin/analytics?startDate=2025-01-01&endDate=2025-12-31&limit=20",
              "host": ["{{BASE_URL}}"],
              "path": ["chatbot", "admin", "analytics"],
              "query": [
                {
                  "key": "startDate",
                  "value": "2025-01-01"
                },
                {
                  "key": "endDate",
                  "value": "2025-12-31"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Lấy analytics: top keywords, message distribution, user count, etc."
          },
          "response": []
        },
        {
          "name": "Get Unknown Queries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ADMIN_TOKEN}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/chatbot/admin/unknown-queries?limit=20&page=1",
              "host": ["{{BASE_URL}}"],
              "path": ["chatbot", "admin", "unknown-queries"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Lấy danh sách queries không tìm thấy sản phẩm (yêu cầu admin/support)"
          },
          "response": []
        }
      ]
    }
  ]
}
